# Copy to backend/.env for local development. On a hosted platform, set
# these as environment variables in its dashboard instead.

PORT=4000

# Either a single connection string (hosted) ...
# DATABASE_URL=postgres://user:password@host:5432/attendance_fine_db
# DATABASE_SSL=true            # needed by most hosted Postgres on external URLs
# ... or individual settings (local).
PGHOST=localhost
PGPORT=5432
PGDATABASE=attendance_fine_db
PGUSER=postgres
PGPASSWORD=postgres

# Python used for blueprint analysis (scripts/sam_analyzer.py).
# PYTHON_BIN=python3

# Google Sheets sync (optional)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive evidence uploads (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# DRIVE_FOLDER_ID=
