# Copy to backend/.env for local development. On a hosted platform, set
# these as environment variables in its dashboard instead.

PORT=4000

# --- Login protection ---------------------------------------------------
# Secret used to sign login tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, a random one is generated on each start (everyone is signed out on restart).
JWT_SECRET=
# How long a login stays valid (jsonwebtoken format: 12h, 7d, ...).
JWT_EXPIRES_IN=12h
# The owner/developer account. It has full access to everything.
OWNER_EMPLOYEE_CODE=LINHDT15
# Password for the owner account, used only to create it on first start.
# Change it afterwards from the dashboard; this value is then ignored.
OWNER_PASSWORD=

# Either a single connection string (hosted) ...
# DATABASE_URL=postgres://user:password@host:5432/attendance_fine_db
# DATABASE_SSL=true            # needed by most hosted Postgres on external URLs
# ... or individual settings (local).
PGHOST=localhost
PGPORT=5432
PGDATABASE=attendance_fine_db
PGUSER=postgres
PGPASSWORD=postgres

# Python used for blueprint analysis (scripts/sam_analyzer.py).
# PYTHON_BIN=python3

# Google Sheets sync (optional)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive evidence uploads (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# DRIVE_FOLDER_ID=
